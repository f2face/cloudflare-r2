{
    "name": "node-cloudflare-r2",
    "version": "0.7.0",
    "description": "S3 wrapper for Cloudflare R2.",
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/esm/index.d.ts",
    "scripts": {
        "build": "rimraf lib/ && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/postbuild.mjs",
        "build:watch:cjs": "rimraf lib/ && tsc -p tsconfig.cjs.json --watch",
        "build:watch:esm": "rimraf lib/ && tsc -p tsconfig.esm.json --watch",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "cloudflare",
        "r2",
        "cloud",
        "storage"
    ],
    "files": [
        "lib/cjs",
        "lib/esm",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./lib/esm/index.d.ts",
            "import": "./lib/esm/index.js",
            "require": "./lib/cjs/index.js",
            "default": "./lib/cjs/index.js"
        },
        "./types": {
            "types": "./lib/esm/types.d.ts",
            "import": "./lib/esm/types.js",
            "require": "./lib/cjs/types.js",
            "default": "./lib/cjs/types.js"
        }
    },
    "license": "ISC",
    "author": "Surya Oktafendri <dev@f2face.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/f2face/cloudflare-r2.git"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1068.0",
        "@aws-sdk/lib-storage": "^3.1068.0",
        "@aws-sdk/s3-request-presigner": "^3.1068.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.9.3",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.11",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0"
    }
}

